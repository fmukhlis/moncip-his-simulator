// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid(2))
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients          Patient[]
  labOrders         LabOrder[]
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

enum PatientSex {
  M
  F
}

enum CoverageType {
  SELF_PAY
  BPJS
  INSURANCE
}

enum EncounterType {
  OPD
  IPD
  ER
}

enum EncounterStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum OrderPriority {
  ROUTINE
  STAT
}

enum LabOrderStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum LabOrderItemStatus {
  ACTIVE
  CANCELLED
}

enum OrderableType {
  SINGLE
  PANEL
}

model Patient {
  id                String            @id @default(cuid(2))
  userId            String
  
  sex               PatientSex
  phone             String?
  email             String?
  address           String?
  fullName          String
  mrnNumber         Int               
  birthDate         DateTime
  nationalId        String?           

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  user              User              @relation(fields: [userId], references: [id])
  labOrders         LabOrder[]
  encounters        Encounter[]

  @@unique([mrnNumber, userId])
  @@unique([nationalId, userId])
}

model Provider {
  id         String      @id @default(cuid(2))
  code       String      @unique
  name       String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  labOrders  LabOrder[]
  encounters Encounter[]
}

model Unit {
  id         String      @id @default(cuid(2))
  code       String      @unique
  name       String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  encounters Encounter[]
}

model Encounter {
  id                            String            @id @default(cuid(2))
  unitId                        String            
  patientId                     String
  providerId                    String            

  no                            String                     
  type                          EncounterType
  period                        String
  reason                        String?
  status                        EncounterStatus   @default(ACTIVE)
  sequence                      Int    
  coverageType                  CoverageType

  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  deletedAt                     DateTime?
  dateTime                      DateTime          @default(now())

  unit                          Unit              @relation(fields: [unitId], references: [id])
  patient                       Patient           @relation(fields: [patientId], references: [id])
  provider                      Provider          @relation(fields: [providerId], references: [id])

  labOrders                     LabOrder[]

  @@unique([patientId, no])
}

model EncounterCounter {
  period            String            @id
  sequence          Int
  updatedAt         DateTime          @updatedAt
}

model OrderableService {
  id                String            @id @default(cuid(2))

  code              String            @unique
  name              String
  price             Decimal?          @db.Decimal(12, 2)
  category          String
  description       String?
  orderableType     OrderableType     

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  labOrderItems LabOrderItem[]
}

model LabOrder {
  id                 String          @id @default(cuid(2))
  userId             String
  patientId          String
  encounterId        String
  orderingProviderId String

  no                 String          
  period             String
  status             LabOrderStatus  @default(DRAFT)
  priority           OrderPriority   @default(ROUTINE)
  sequence           Int
  clinicalNote       String?
  
  orderedAt          DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  user               User            @relation(fields: [userId], references: [id])
  items              LabOrderItem[]
  patient            Patient         @relation(fields: [patientId], references: [id])
  encounter          Encounter       @relation(fields: [encounterId], references: [id])
  orderingProvider   Provider        @relation(fields: [orderingProviderId], references: [id])

  @@unique([userId, no])
  @@index([userId, patientId])
  @@index([userId, encounterId])
  @@index([userId, status])
  @@index([orderedAt])
}

model LabOrderCounter {
  period            String            @id
  sequence          Int
  updatedAt         DateTime          @updatedAt
}

model LabOrderItem {
  id                    String             @id @default(cuid(2))
  labOrderId            String
  orderableServiceId    String

  status                LabOrderItemStatus @default(ACTIVE)
  priceSnapshot         Decimal?           @db.Decimal(12, 2)
  orderableCodeSnapshot String
  orderableNameSnapshot String
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  labOrder              LabOrder           @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  orderableService      OrderableService   @relation(fields: [orderableServiceId], references: [id])

  @@index([labOrderId])
  @@index([orderableServiceId])
}
