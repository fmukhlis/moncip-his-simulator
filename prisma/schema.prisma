generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatientSex {
  M
  F
}

enum CoverageType {
  SELF_PAY
  BPJS
  INSURANCE
}

enum EncounterType {
  OPD
  IPD
  ER
}

enum EncounterStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}


model Patient {
  id                String            @id @default(cuid(2))
  mrn               String            @unique
  nationalId        String?           @unique
  
  sex               PatientSex
  phone             String?
  email             String?
  address           String?
  fullName          String
  metadata          Json?
  birthDate         DateTime

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  encounters        Encounter[]
}

model Encounter {
  id                String            @id @default(cuid(2))
  patientId         String            

  status            EncounterStatus   @default(ACTIVE)
  reason            String?
  provider          String
  department        String
  coverageType      CoverageType
  encounterType     EncounterType

  startDate         DateTime          @default(now())
  endDate           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  metadata          Json?

  patient           Patient           @relation(fields: [patientId], references: [id])
}
